NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
# API and workers MUST use the same absolute DATA_DIR when set.
# DATA_DIR=/absolute/path/to/Sarvya/backend/data
SCAN_QUEUE_NAME=sarvya-scans
SCAN_WORKER_CONCURRENCY=1
SCAN_GLOBAL_CONCURRENCY=2
SCAN_ATTEMPTS=3
SCAN_BACKOFF_MS=1000
SCAN_JOB_TIMEOUT_MS=180000
SCAN_NAVIGATION_TIMEOUT_MS=20000

# GitHub OAuth App: register it in GitHub > Settings > Developer settings.
# Keep these values server-side. Leave blank to show the coming-soon UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate at least 32 random bytes, e.g. openssl rand -hex 32
GITHUB_SESSION_SECRET=
# Must use the same origin/hostname as FRONTEND_ORIGIN; Vite proxies this route.
GITHUB_CALLBACK_URL=http://localhost:5173/api/github/oauth/callback
# public_repo for public repositories only; repo to include private repositories.
GITHUB_OAUTH_SCOPE=public_repo

# Scheduled audits: run `npm run monitor` alongside `npm run worker`.
# Both processes need the same REDIS_URL, SCAN_QUEUE_NAME, and DATA_DIR.
# The monitor queue name is SCAN_QUEUE_NAME + "-monitors"; schedule/time-zone
# configuration is saved by the monitoring API, not environment variables.

# Production workspace access (required when NODE_ENV=production).
# Use a password manager to generate >=20 characters; Render stores these as secrets.
ACCESS_USER=
ACCESS_PASSWORD=
API_RATE_LIMIT=600
SCAN_MAX_PENDING_JOBS=100
# Render sets its public origin automatically via RENDER_EXTERNAL_URL.
# STATIC_DIR=/absolute/path/to/frontend/dist
