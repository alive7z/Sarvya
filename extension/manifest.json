{
  "manifest_version": 3,
  "name": "Sarvya Accessibility Auditor",
  "version": "0.1.0",
  "description": "Audit the current page locally with axe-core. Inspect labelled findings and export a report.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background/worker.js", "type": "module" },
  "action": { "default_title": "Audit this page with Sarvya", "default_popup": "popup/index.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
